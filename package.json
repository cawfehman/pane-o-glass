{
  "name": "pane-o-glass",
  "version": "7.7.20",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rimraf .next",
    "build:css": "npx @tailwindcss/cli -i src/app/globals.css -o src/app/compiled-tailwind.css",
    "build:scripts": "npx esbuild scripts/cron/*.ts scripts/utils/*.ts --outdir=dist-scripts --platform=node --format=cjs --bundle --packages=external --alias:@=./src",
    "build": "npm run clean && npx prisma generate && npm run build:css && npm run build:scripts && next build && node scripts/utils/sync-post-receive-pm2.js",
    "cron:crawl": "node dist-scripts/cron/crawl-network.js",
    "cron:shun-snapshot": "node dist-scripts/cron/shun-snapshot.js",
    "cron:citrix-guardian": "node dist-scripts/cron/citrix-guardian.js",
    "daemon:citrix-guardian": "node dist-scripts/cron/citrix-guardian.js",
    "cron:cve-shun": "node dist-scripts/cron/monitor-cve-2026-netscaler.js",
    "cron:vpn-sync": "node dist-scripts/cron/sync-vpn-logs.js --once",
    "daemon:vpn-sync": "node dist-scripts/cron/sync-vpn-logs.js",
    "cron:vpn-health": "node dist-scripts/cron/ping-health-probes.js",
    "daemon:vpn-health": "node dist-scripts/cron/ping-health-probes.js --daemon",
    "cron:lifecycle-sync": "node dist-scripts/cron/sync-account-lifecycle.js --once",
    "daemon:lifecycle-sync": "node dist-scripts/cron/sync-account-lifecycle.js",
    "seed:lifecycle": "node dist-scripts/cron/sync-account-lifecycle.js --seed 7",
    "start": "next start",
    "lint": "next lint",
    "deploy": "git push origin main --follow-tags && git push production main --follow-tags",
    "deploy:patch": "npm version patch && npm run deploy",
    "deploy:minor": "npm version minor && npm run deploy",
    "deploy:major": "npm version major && npm run deploy",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:setup": "ts-node tests/setup/seed-test-users.ts",
    "test:overrides": "npx tsx scripts/test/test-user-overrides.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "ldapts": "^8.1.7",
    "lucide-react": "^0.473.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "node-ssh": "^13.2.1",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.31",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "recharts": "^3.10.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.3.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "@auth/core": "^0.41.3",
    "nodemailer": "$nodemailer"
  }
}
