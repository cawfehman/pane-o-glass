// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  username   String     @unique
  password   String?
  firstName  String?
  lastName   String?
  role       String     @default("USER")
  isExternal Boolean    @default(false)
  isRoleOverridden Boolean @default(false)
  lastLogin  DateTime?
  sessionTimeout Int        @default(10)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  auditLogs      AuditLog[]
  firewallQueries FirewallQueryHistory[]
  feedback       Feedback[]
}

model FirewallQueryHistory {
  id        String   @id @default(cuid())
  userId    String?  
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  command   String   // "Check Shun", "Remove Shun"
  targetIp  String
  targetName String? // e.g. "FW01"
  ipAsn      String?
  ipAsName   String?
  ipAsDomain String?
  ipCountry  String?
  ipCountryCode String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model HealthProbe {
  id        String   @id @default(cuid())
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
}

model ToolPermission {
  id        String   @id @default(cuid())
  toolId    String   // e.g. "firewall", "ise", "ise-failures", "hibp-account", "hibp-domain"
  role      String   // "ADMIN", "ANALYST", "USER"
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([toolId, role])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?  
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tool      String   // URL or Name of the tool
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model BackgroundJob {
  id        String   @id @default(cuid())
  name      String   @unique
  lastRun   DateTime @default(now())
  status    String   // "SUCCESS", "FAILURE"
  message   String?
}

model SiteMapVersion {
  id            String   @id @default(cuid())
  filename      String
  content       String   // Full CSV content
  versionNumber Int
  createdBy     String   // Username of admin
  createdAt     DateTime @default(now())
}

model VpnEvent {
  id            String   @id @default(cuid())
  username      String
  sourceIp      String
  assignedIp    String?
  status        String   // "SUCCESS", "FAILURE", "DISCONNECT"
  duration      Int?     // session duration in seconds
  bytesSent     Float?   // bytes sent
  bytesReceived Float?   // bytes received
  bytesTotal    Float?   // total bytes transferred
  failureReason String?  // explanation of failure
  vpnType       String?  // "SSL" or "IKEv2"
  vpnStream     String?  // "Kel-3140" or "WDC-FTD"
  ipAsn         String?
  ipAsName      String?
  ipAsDomain    String?
  ipCountry     String?
  ipCountryCode String?
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([sourceIp])
  @@index([ipAsn])
}

model IpLookupCache {
  ip          String   @id
  latitude    Float?
  longitude   Float?
  countryCode String?
  city        String?
  subdivision String?
  rawJson     String   // Serialized raw JSON payload from iplocate.io
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuardianEvent {
  id              String   @id @default(uuid())
  ip              String
  firewall        String?
  action          String   // "SHUN_DETECTED", "AUTO_UNSHUNNED", "SKIPPED"
  reason          String?  // "VPN_HISTORY", "HOSTING_TYPE", "NONE"
  companyName     String?
  companyType     String?
  cidr            String?  // asn:route
  asn             String?
  details         String?
  createdAt       DateTime @default(now())

  @@index([ip])
  @@index([action])
}

model GuardianBlacklist {
  ip        String   @id
  reason    String
  createdAt DateTime @default(now())
}

model ShunDatabaseIp {
  ip            String    @id
  
  ipAsn         String?
  org           String?
  ipCountry     String?
  ipCountryCode String?
  city          String?
  continent     String?
  
  enrichedAt    DateTime? 
  
  firewallStats FirewallShunStats[]
  snapshots     FirewallShunSnapshot[]
}

model FirewallShunStats {
  id            String   @id @default(cuid())
  ip            String
  firewall      String
  
  firstSeen     DateTime @default(now()) 
  lastSeen      DateTime @default(now()) 
  daysShunned   Int      @default(1)     
  isActive      Boolean  @default(true)  
  
  shunIp        ShunDatabaseIp @relation(fields: [ip], references: [ip], onDelete: Cascade)

  @@unique([ip, firewall])
  @@index([ip])
  @@index([firewall])
}

model FirewallShunSnapshot {
  id            String   @id @default(cuid())
  ip            String
  firewall      String
  snapshotDate  DateTime 
  
  shunIp        ShunDatabaseIp @relation(fields: [ip], references: [ip], onDelete: Cascade)

  @@index([ip])
  @@index([snapshotDate])
}

model IronportHourlyStat {
  id              String   @id @default(cuid())
  timestamp       DateTime @unique
  inboundVolume   Int      @default(0)
  outboundVolume  Int      @default(0)
  delayedCount    Int      @default(0)
  phishingCount   Int      @default(0)
  malwareCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([timestamp])
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String   @default("BREACH") // "BREACH", "SECURITY_ALERT", "GENERAL"
  subject     String
  bodyHtml    String
  bodyText    String?
  isEnabled   Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaigns   NotificationCampaign[]
}

model NotificationCampaign {
  id              String   @id @default(cuid())
  name            String
  breachName      String?  // Explicit incident/breach name (e.g., "LinkedIn", "Adobe")
  templateId      String?
  template        NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status          String   @default("DRAFT") // "DRAFT", "TEST_SENT", "APPROVED", "SENDING", "COMPLETED", "COMPLETED_WITH_ERRORS", "STALLED", "CANCELLED"
  sourceType      String   @default("HIBP_DOMAIN") // "HIBP_DOMAIN", "CSV_UPLOAD"
  sourceQuery     String?  // e.g., "LinkedIn", "Passwords AND Credit cards"
  totalCount      Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  testSentTo      String?
  testSentAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  recipients      CampaignRecipient[]

  @@index([status, createdAt])
}

model CampaignRecipient {
  id                  String    @id @default(cuid())
  campaignId          String
  campaign            NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email               String
  name                String?
  adName              String?
  accountStatus       String?   // "Active", "Disabled"
  breachName          String?
  breachDate          String?
  breachDetails       String?
  variablesJson       String?   // Full key-value dictionary for dynamic replacement
  status              String    @default("PENDING") // "PENDING", "TEST_SENT", "SENT", "FAILED"
  sentAt              DateTime?
  errorMessage        String?

  @@index([campaignId, status])
  @@index([email])
}

