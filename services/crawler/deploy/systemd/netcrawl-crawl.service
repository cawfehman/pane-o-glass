[Unit]
Description=NetCrawl Daily Network Discovery Crawl
After=network.target

[Service]
Type=oneshot
User=netcrawl
Group=netcrawl
WorkingDirectory=/opt/netcrawl
EnvironmentFile=/opt/netcrawl/.env
ExecStart=/opt/netcrawl/venv/bin/python main.py crawl
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
