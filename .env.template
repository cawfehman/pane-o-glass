# Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/pane_o_glass_dev?schema=public"

# -----------------------------------------------------------------------------
# NextAuth / Security
# Generate a secret using: `openssl rand -base64 32`
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="REPLACE_ME_SECURE_SECRET"
AUTH_SECRET="REPLACE_ME_SECURE_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Active Directory / LDAP Integration
# -----------------------------------------------------------------------------
AD_URL="ldaps://your.ldap.server:636"
AD_BIND_DN="CN=ServiceAccount,OU=Users,DC=example,DC=com"
AD_BIND_PASSWORD="REPLACE_ME_PASSWORD"
AD_BASE_DN="DC=example,DC=com"
AD_LDAPS_REJECT_UNAUTHORIZED="true"

# -----------------------------------------------------------------------------
# Cisco Firewall Configuration
# JSON array of gateway objects:
# [{ "id": "fw1", "name": "Main Firewall", "ip": "10.0.0.1", "user": "admin", "pass": "secret" }]
# -----------------------------------------------------------------------------
FIREWALL_CONFIG='[]'

# -----------------------------------------------------------------------------
# Cisco Network Crawler (Admin Network Discovery & Path Tracer)
# Optional: Overrides services/crawler/config.yaml for live SSH switch authentication
# -----------------------------------------------------------------------------
NETCRAWL_USER="admin"
NETCRAWL_PASS="REPLACE_ME_SSH_PASSWORD"
NETCRAWL_SECRET="REPLACE_ME_ENABLE_SECRET"
# NETCRAWL_KEY_FILE="/path/to/private_key"


# -----------------------------------------------------------------------------
# Cisco ISE (Identity Services Engine)
# -----------------------------------------------------------------------------
ISE_PAN_URL="https://ise-pan.example.com"
ISE_API_USER="admin"
ISE_API_PASSWORD="secret"
ISE_FAILURES_BASE_URL="https://ise-mnt.example.com"
ISE_HOST="https://ise.example.com"
ISE_USER="admin"
ISE_PASS="secret"
ISE_REJECT_UNAUTHORIZED="false"

# -----------------------------------------------------------------------------
# Graylog (Syslog / VPN Telemetry)
# -----------------------------------------------------------------------------
GRAYLOG_URL="https://graylog.example.com:9000"
GRAYLOG_API_TOKEN="your_graylog_api_token"
GRAYLOG_STREAM_ID="stream_id_1,stream_id_2" # Comma-separated list of stream IDs
GRAYLOG_REJECT_UNAUTHORIZED="false"

# Legacy / OG Graylog Compatibility
OG_GRAYLOG_URL="https://graylog.example.com:9000"
OG_GRAYLOG_API_TOKEN="your_token_here"

# -----------------------------------------------------------------------------
# Have I Been Pwned (HIBP)
# Required for account & domain breach queries
# -----------------------------------------------------------------------------
HIBP_API_KEY="your_hibp_api_key_here"

# -----------------------------------------------------------------------------
# SMTP Relay (Notification Center & Security Alerts)
# -----------------------------------------------------------------------------
SMTP_HOST="mail.example.com"
SMTP_PORT="25"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM='"Information Security Alerts" <infosec-alerts@example.com>'
SMTP_REPLY_TO="security-helpdesk@example.com"
SMTP_SEND_DELAY_MS="500" # Rate limiter delay in ms (500ms = ~120 emails/min)
SMTP_TLS_REJECT_UNAUTHORIZED="true"
SMTP_MOCK="false" # Set to "true" in local dev to simulate email dispatch without an active relay

# -----------------------------------------------------------------------------
# Vectra AI Security Platform
# -----------------------------------------------------------------------------
VECTRA_URL="https://vectra.example.com/api/v3.4"
VECTRA_CLIENT_ID="your_vectra_client_id"
VECTRA_CLIENT_SECRET="your_vectra_client_secret"
VECTRA_REJECT_UNAUTHORIZED="false"

# -----------------------------------------------------------------------------
# IP Geolocation & ASN Intelligence
# -----------------------------------------------------------------------------
IPINFO_TOKEN="your_ipinfo_token_here"
IPLOCATE_API_KEY="your_iplocate_api_key_here"

# -----------------------------------------------------------------------------
# Data Retention & Telemetry Purge Settings
# -----------------------------------------------------------------------------
BEC_RAW_URL_RETENTION_DAYS="14" # Automatically prune raw URL records older than X days
